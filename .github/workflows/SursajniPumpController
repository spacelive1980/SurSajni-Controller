        }

        // --- ACTION HANDLERS ---
        function toggleAccordion(id) {
            const content = document.getElementById(`content-${id}`);
            const icon = document.getElementById(`icon-${id}`);
            const isOpen = content.style.maxHeight;
            document.querySelectorAll('.accordion-content').forEach(c => c.style.maxHeight = null);
            document.querySelectorAll('[id^="icon-"]').forEach(i => i.classList.remove('rotate-180'));
            if (!isOpen) {
                content.style.maxHeight = content.scrollHeight + "px";
                icon.classList.add('rotate-180');
            }
        }
        function factoryReset() { showConfirmModal('Factory Reset?', 'This will erase all settings.', () => postAction('/factory_reset', null, true)); }

        // --- NEW: AUTO-CALIBRATION FUNCTIONS ---
        let calibCleanValue, calibDirtyValue;

        function startCalibration() {
            const msgEl = document.getElementById('calibrationMessage');
            const actionBtn = document.getElementById('calibrationActionBtn');
            const closeBtn = document.getElementById('calibrationCloseBtn');
            const progressContainer = document.getElementById('calibrationProgressContainer');
            const resultEl = document.getElementById('calibrationResult');

            // Reset UI
            progressContainer.classList.add('hidden');
            resultEl.classList.add('hidden');
            actionBtn.disabled = false;
            closeBtn.disabled = false;

            // Start Step 1
            msgEl.textContent = "Step 1: Dip sensor in CLEAN water, then press Start.";
            actionBtn.textContent = "Start Clean Sample";
            actionBtn.onclick = () => runCalibrationStep('clean');
            openModal('calibrationModal');
        }

        async function runCalibrationStep(step) {
            const msgEl = document.getElementById('calibrationMessage');
            const actionBtn = document.getElementById('calibrationActionBtn');
            const closeBtn = document.getElementById('calibrationCloseBtn');
            const progressContainer = document.getElementById('calibrationProgressContainer');
            const progressBar = document.getElementById('calibrationProgressBar');
            
            actionBtn.disabled = true;
            closeBtn.disabled = true;
            msgEl.textContent = `Sampling ${step} water for 5 seconds...`;
            progressContainer.classList.remove('hidden');
            progressBar.style.width = '0%';
            
            const readings = [];
            const sampleInterval = 250; // ms
            const duration = 5000; // 5 seconds
            const totalSamples = duration / sampleInterval;

            for (let i = 0; i < totalSamples; i++) {
                try {
                    const response = await apiCall('/get_live_data');
                    if(response) {
                        const data = await response.json();
                        readings.push(data.turbidityValue);
                    }
                } catch (e) { console.error(e); }
                progressBar.style.width = `${((i + 1) / totalSamples) * 100}%`;
                await new Promise(resolve => setTimeout(resolve, sampleInterval));
            }
            
            const avg = Math.round(readings.reduce((a, b) => a + b, 0) / readings.length);

            if (step === 'clean') {
                calibCleanValue = avg;
                document.getElementById('calibCleanResult').textContent = calibCleanValue;
                msgEl.textContent = "Step 2: Dip sensor in DIRTY water, then press Start.";
                actionBtn.textContent = "Start Dirty Sample";
                actionBtn.onclick = () => runCalibrationStep('dirty');
                actionBtn.disabled = false;
                closeBtn.disabled = false;
            } else { // 'dirty' step
                calibDirtyValue = avg;
                document.getElementById('calibDirtyResult').textContent = calibDirtyValue;
                
                // Calculate and save
                const newLimit = Math.round(calibCleanValue + (calibDirtyValue - calibCleanValue) * 0.75);
                document.getElementById('calibLimitResult').textContent = newLimit;

                const body = new URLSearchParams();
                body.append('calibratedCleanValue', calibCleanValue);
                body.append('calibratedDirtyValue', calibDirtyValue);
                body.append('turbidityLimit', newLimit);
                await postAction('/update_all_settings', body, true);

                msgEl.textContent = "Calibration Complete!";
                document.getElementById('calibrationResult').classList.remove('hidden');
                actionBtn.textContent = "Done";
                actionBtn.onclick = () => closeModal('calibrationModal');
                actionBtn.disabled = false;
                closeBtn.disabled = true; // Only Done button should be active
            }
        }
        
        async function saveAllSettings() {
            showLoading();
            const formData = new URLSearchParams();
            const settingsPage = document.getElementById('page-settings');
            
            settingsPage.querySelectorAll('input, select').forEach(el => {
                // Use the 'name' attribute for form submissions, which is the web standard.
                if (!el.name) return;

                // If the password input is empty, don't include it in the request.
                // This prevents the device from rejecting the entire settings batch.
                if (el.name === 'httpPassword' && el.value === '') {
                    return; 
                }
                
                if (el.type === 'checkbox') {
                    formData.append(el.name, el.checked ? '1' : '0');
                } else if (el.name === 'endSensorLevel') {
                    // The UI select element for End Level uses values 0-3.
                    // The device's firmware expects these values to be 1-4.
                    // We must add 1 to the value before sending it.
                    formData.append(el.name, parseInt(el.value, 10) + 1);
                } else {
                    formData.append(el.name, el.value);
                }
            });
            
            await postAction('/update_all_settings', formData, true);
            hideLoading();
        }


        // --- INITIALIZATION ---
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('footer-year').textContent = new Date().getFullYear();
            const connectionDetails = loadConnectionDetails();
            connectionSettingsBtn.addEventListener('click', () => openModal('connectionModal'));
            if (connectionDetails) {
                STATE.connection = connectionDetails;
                showLoading();
                fetchAndUpdate(true).finally(hideLoading);
            } else {
                openModal('connectionModal');
            }
        });
    </script>
</body>
