        function updateSchedulesPage(data, selectedIndex) {
            const selector = document.getElementById('scheduleSelector');
            const currentIndex = selectedIndex !== undefined ? selectedIndex : (selector ? selector.value : 0);
            
            if (selector) { // Update selector labels on each data refresh
                selector.innerHTML = data.schedules.map((s, i) => {
                     const isBlank = s.hour === 0 && s.minute === 0 && s.year === 0;
                     const label = isBlank ? `Schedule ${i + 1} (Not Set)` : `Schedule ${i + 1} (${String(s.hour).padStart(2, '0')}:${String(s.minute).padStart(2, '0')})`;
                     return `<option value="${i}">${label}</option>`;
                }).join('');
                selector.value = currentIndex;
            }

            const schedule = data.schedules[currentIndex];
            const isBlank = schedule.hour === 0 && schedule.minute === 0 && schedule.year === 0;
            const rtc = data.rtc;

            if (isBlank && rtc) { // Auto-populate if blank
                document.getElementById('schedHour').value = rtc.hour;
                document.getElementById('schedMinute').value = rtc.minute;
                const specificDateIndex = CONSTANTS.repeatTypeMap.indexOf('SPECIFIC_DATE');
                document.getElementById('schedRepeatType').value = specificDateIndex;
                document.getElementById('schedYear').value = rtc.year;
                document.getElementById('schedMonth').value = rtc.month;
                document.getElementById('schedDay').value = rtc.day;
            } else { // Populate with existing data
                document.getElementById('schedHour').value = schedule.hour;
                document.getElementById('schedMinute').value = schedule.minute;
                document.getElementById('schedRepeatType').value = CONSTANTS.repeatTypeMap.indexOf(schedule.repeatType);
                document.getElementById('schedYear').value = schedule.year;
                document.getElementById('schedMonth').value = schedule.month;
                document.getElementById('schedDay').value = schedule.day;
            }
            // Toggle date fields visibility
            const repeatIndex = document.getElementById('schedRepeatType').value;
            document.getElementById('scheduleDateFields').classList.toggle('hidden', repeatIndex != CONSTANTS.repeatTypeMap.indexOf('SPECIFIC_DATE'));
        }
        
